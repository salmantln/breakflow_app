{
  "name": "breakflow_app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salmantln/breakflow_app.git"
  },
  "version": "1.0.0",
  "description": "Avoid eye strain, stay focus.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "watch": "nodemon --exec electron .",
    "generate-icons": "node scripts/generate-icons.js",
    "pack": "electron-builder --dir",
    "build": "electron-builder -mw",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "author": "Sarl Studio",
  "license": "ISC",
  "build": {
    "appId": "com.sarlstudio.breakreminder.app",
    "productName": "Break Flow",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "src/**/*",
      "assets/**/*",
      "resources/**/*",
      "fonts/**/*",
      "node_modules/electron-log/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": "fonts/",
          "to": "fonts/",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Break Flow"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon.png",
      "category": "Utility"
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "dependencies": {
    "active-win": "^7.7.2",
    "electron-log": "^5.2.3",
    "electron-store": "^8.1.0",
    "electron-util": "^0.18.1",
    "get-windows": "^9.2.0",
    "loudness": "^0.4.2",
    "nodemon": "^3.1.9",
    "nucleo-core-fill-24": "^1.1.3",
    "posthog-js": "^1.194.1",
    "posthog-node": "^4.3.1",
    "ps-list": "^8.1.1",
    "systeminformation": "^5.25.11"
  },
  "bugs": {
    "url": "https://github.com/salmantln/breakflow_app/issues"
  },
  "homepage": "https://github.com/salmantln/breakflow_app#readme"
}
